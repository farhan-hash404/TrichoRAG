{
  "name": "TrichoRAG: full system",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [3000, 8000],
  "portsAttributes": {
    "3000": { "label": "TrichoRAG website", "onAutoForward": "openBrowser" },
    "8000": { "label": "TrichoRAG API (docs at /docs)", "onAutoForward": "silent" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
